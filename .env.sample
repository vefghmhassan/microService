# HTTP port the panel listens on.
APP_PORT=8090
# Directory for the SQLite database, the SSH key and generated secrets.
DATA_DIR=./data
# First admin account, created only when no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional. When empty, random values are generated once and kept in DATA_DIR.
JWT_SECRET=
# 32 bytes, hex. Encrypts provider tokens and panel passwords at rest.
MASTER_KEY=
# Set to true behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
